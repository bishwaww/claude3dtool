{
  "name": "stick-knowledge-3d-studio",
  "productName": "Stick Knowledge 3D Studio",
  "version": "1.0.0",
  "description": "Claude-powered Zack D. Films-style 3D Shorts studio that builds live in Blender",
  "author": "Stick Knowledge",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.stickknowledge.studio3d",
    "productName": "Stick Knowledge 3D Studio",
    "executableName": "StickKnowledge3DStudio",
    "artifactName": "StickKnowledge3DStudio-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/stick-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stick Knowledge 3D Studio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bishwaww",
        "repo": "claude3dtool",
        "releaseType": "release"
      }
    ]
  }
}
